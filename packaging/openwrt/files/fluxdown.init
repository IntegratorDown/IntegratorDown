#!/bin/sh /etc/rc.common
# IntegratorDown headless server — procd service
# UCI 配置见 /etc/config/integratordown

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/integratordown-agent

start_service() {
	config_load integratordown

	local enabled bind data_dir token
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get bind main bind "0.0.0.0:17800"
	config_get data_dir main data_dir "/etc/integratordown"
	config_get token main token ""

	mkdir -p "$data_dir"

	procd_open_instance
	# agent 在 --server 模式下拉起同级 integratordownd，SIGTERM 时一并关停 daemon
	procd_set_param command "$PROG" --server
	# INTEGRATORDOWN_INSTALL_SOURCE：二进制归 opkg 管理，应用内更新只提示安装新 ipk
	procd_set_param env \
		INTEGRATORDOWN_BIND="$bind" \
		INTEGRATORDOWN_DATA_DIR="$data_dir" \
		INTEGRATORDOWN_INSTALL_SOURCE=openwrt
	# 非空 token：预置访问密钥并每次启动强制覆盖；留空则由 Web 界面首次访问时设置
	if [ -n "$token" ]; then
		procd_append_param env INTEGRATORDOWN_TOKEN="$token" INTEGRATORDOWN_TOKEN_FORCE=1
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger integratordown
}
